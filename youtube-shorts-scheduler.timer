[Unit]
Description=Run YouTube Shorts Generator 4 times a day Mon-Sat (IST)

[Timer]
OnCalendar=
OnCalendar=Mon..Sat *-*-* 03:30:00 UTC
OnCalendar=Mon..Sat *-*-* 06:30:00 UTC
OnCalendar=Mon..Sat *-*-* 09:30:00 UTC
OnCalendar=Mon..Sat *-*-* 12:30:00 UTC
Persistent=true
AccuracySec=1s
Unit=youtube-shorts-scheduler.service

[Install]
WantedBy=timers.target