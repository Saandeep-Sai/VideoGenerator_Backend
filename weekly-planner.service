[Unit]
Description=Weekly Content Planner Service
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/VideoGenerator_Backend
ExecStart=/home/ubuntu/VideoGenerator_Backend/.venv/bin/python /home/ubuntu/VideoGenerator_Backend/weekly_planner.py
Environment="PATH=/home/ubuntu/VideoGenerator_Backend/.venv/bin:/usr/local/bin:/usr/bin:/bin"
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
